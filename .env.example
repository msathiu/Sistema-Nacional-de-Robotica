# ============================================
# CONFIGURACIÓN DEL SISTEMA NACIONAL DE ROBÓTICA
# ============================================

# --- SEGURIDAD ---
# IMPORTANTE: Genera una clave secreta única para producción
# Puedes usar: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

# Modo de depuración (NUNCA usar True en producción)
DEBUG=True

# Hosts permitidos (separados por comas, sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1

# --- BASE DE DATOS ---
# Para SQLite (desarrollo):
# DATABASE_URL=sqlite:///db.sqlite3
# Para PostgreSQL (producción):
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/nombre_bd
DATABASE_URL=sqlite:///db.sqlite3

# Configuración PostgreSQL (si usas Docker)
POSTGRES_DB=robotica_db
POSTGRES_USER=robotica_user
POSTGRES_PASSWORD=change_me_in_production

# --- CONFIGURACIÓN DE EMAIL ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=tu_usuario_mailtrap
EMAIL_HOST_PASSWORD=tu_password_mailtrap
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=registro@fvrc.org.ve

# --- CONFIGURACIÓN DEL SITIO ---
SITE_NAME=Registro Nacional para Robótica Creativa
BASE_URL=http://localhost:8000

# --- SEGURIDAD ADICIONAL (Producción) ---
# Orígenes confiables para CSRF (separados por comas)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://tudominio.com

# Redirección SSL (solo en producción con HTTPS)
SECURE_SSL_REDIRECT=False

# HSTS (HTTP Strict Transport Security) - segundos
SECURE_HSTS_SECONDS=31536000

# --- LOGGING ---
# Niveles: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# --- DJANGO SETTINGS MODULE ---
DJANGO_SETTINGS_MODULE=SistemaRegistro.settings
