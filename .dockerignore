# --- Git ---
.git
.gitignore

# --- Secretos y Configuración ---
.env
.env.*
!.env.example
secrets.json

# --- Entorno Virtual de Python (¡MUY IMPORTANTE!) ---
# Nunca copies el venv de tu PC al contenedor; Docker instalará el suyo
venv/
env/
.venv/
bin/
lib/
share/

# --- Cache de Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# --- Archivos Estáticos y Media ---
# Docker debe generar sus propios staticfiles mediante collectstatic
staticfiles/
media/
db.sqlite3

# --- Documentación y Otros ---
*.md
.vscode/
.idea/
*.swp
*.swo

# --- Docker ---
!Dockerfile-prod
!docker-compose-prod.yml
.dockerignore

# --- Datos de contenedores (CRÍTICO) ---
data/
pgdata/
postgres_data/
redis_data/
docker-data/
volumes/

# --- Logs ---
logs/
log/
*.log
django.log

# --- Python builds ---
build/
dist/
*.egg-info/
.eggs/

# --- Test coverage ---
.coverage.*
htmlcov/

# --- Node.js (si aplica en futuro) ---
node_modules/
package-lock.json
yarn.lock

# --- SQL temporales ---
*.sql

# --- Temporales ---
temp/
tmp/

# --- Documentación y planes locales ---
docs/
plan/
SIN_USO/
old/
backup/
backups/
*.md
